{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gajae-code.github.io/gajae-code-presets/schemas/profile.v1.schema.json",
  "title": "Gajae Code safe model profile set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "dynamicProviders", "profiles"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "revision": { "type": "string", "pattern": "^[0-9]{8}$" },
    "dynamicProviders": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "profiles": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/profile" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "selector": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\s\\p{Cc}]+$" },
    "binding": {
      "oneOf": [
        { "$ref": "#/$defs/selector" },
        { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/selector" } }
      ]
    },
    "roleBindings": {
      "type": "object", "additionalProperties": false, "minProperties": 1, "required": ["default"],
      "properties": {
        "default": { "$ref": "#/$defs/binding" }, "executor": { "$ref": "#/$defs/binding" },
        "architect": { "$ref": "#/$defs/binding" }, "planner": { "$ref": "#/$defs/binding" },
        "critic": { "$ref": "#/$defs/binding" }
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "displayName", "providerGroup", "requiredProviders", "roleBindings"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\p{Cc}]+$" },
        "providerGroup": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\p{Cc}]+$" },
        "requiredProviders": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "alternativeProviderGroups": {
          "type": "array", "maxItems": 16, "items": {
            "type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" }
          }
        },
        "roleBindings": { "$ref": "#/$defs/roleBindings" }
      }
    }
  }
}
